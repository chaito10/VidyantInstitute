{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vidyarthi portable credential v1.0 (§8.1 — signed record, no blockchain required)",
  "type": "object",
  "required": ["credential_id", "learner", "course_id", "course_revision", "outcomes", "issuer", "issuer_authority", "policy", "issued_at", "signature"],
  "properties": {
    "credential_id": { "type": "string" },
    "learner": { "type": "string", "description": "Learner identifier or public-key binding" },
    "course_id": { "type": "string" },
    "course_revision": { "type": "string" },
    "outcomes": { "type": "array", "items": { "type": "string" } },
    "credit": { "type": "object" },
    "evidence_ref": { "type": "string" },
    "issuer": { "type": "string" },
    "issuer_authority": { "type": "string" },
    "policy": { "type": "string" },
    "kind": { "enum": ["community", "institution", "legally-recognized"], "description": "UI must distinguish these (§8.3)" },
    "issued_at": { "type": "integer" },
    "status": { "type": "string" },
    "signature": { "type": "string", "description": "Ed25519 signature over canonical JSON" }
  }
}
