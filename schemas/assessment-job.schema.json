{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vidyarthi assessment job v1.0 (§5.3, application-level — adapter translates to Pipelight steps)",
  "type": "object",
  "required": ["schema_version", "job_id", "course_id", "course_revision", "submission_id", "runner", "tests"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_id": { "type": "string" },
    "course_id": { "type": "string" },
    "course_revision": { "type": "string" },
    "submission_id": { "type": "string" },
    "runner": { "enum": ["wasm", "rust-restricted", "isolated"] },
    "tests": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_seconds": { "type": "integer", "default": 30 },
        "memory_mb": { "type": "integer", "default": 128 },
        "network": { "type": "boolean", "default": false }
      }
    }
  }
}
